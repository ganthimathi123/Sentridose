# Backend Configuration
ENVIRONMENT=production
CORS_ORIGINS=http://localhost:5173,https://your-supervisor-domain.com,https://your-worker-domain.com

# Database (Default PostgreSQL in production, SQLite for local fallback)
DATABASE_URL=postgresql://user:password@localhost:5432/sentridose_db

# Security & Authentication
JWT_SECRET=your_production_jwt_secret_key_change_in_prod
SECRET_KEY=your_production_secret_key

# Upload Directory
UPLOAD_DIR=uploads

# Optional FCM Notification Credentials
FIREBASE_CREDENTIALS=path/to/firebase-credentials.json
