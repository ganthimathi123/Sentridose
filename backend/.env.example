# SentriDose Production Environment Variables Template

# Application Environment
ENVIRONMENT=production
PROJECT_NAME="SentriDose Exposure Dosimeter System"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Production PostgreSQL Database Connection URL
# Example: postgresql://postgres:password@db-host.internal:5432/sentridose_db
DATABASE_URL=postgresql://user:password@localhost:5432/sentridose

# JWT & Security Configuration
JWT_SECRET=replace_this_with_a_secure_random_64_character_hex_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Production CORS Configuration (Comma-separated allowed origins)
# Example: https://worker.sentridose.com,https://supervisor.sentridose.com
CORS_ORIGINS=https://worker.sentridose.com,https://supervisor.sentridose.com

# Optional Cloud Image Storage Settings
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
